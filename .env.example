# Local Docker Postgres (used by docker-compose.yml)
DATABASE_URL=postgresql://fpl:fpl@localhost:5432/fpl

# Your FPL team/entry ID (find it in the URL when viewing your team on fantasy.premierleague.com)
FPL_TEAM_ID=

# Optional: FPL account login, only needed for endpoints that require auth (e.g. transfers)
FPL_EMAIL=
FPL_PASSWORD=
