# Local Docker Postgres (used by docker-compose.yml)
DATABASE_URL=postgresql://fpl:fpl@localhost:5432/fpl

# Your FPL team/entry ID (find it in the URL when viewing your team on fantasy.premierleague.com)
FPL_TEAM_ID=

# Optional: FPL account login, only needed for endpoints that require auth (e.g. transfers)
FPL_EMAIL=
FPL_PASSWORD=

# Grafana (defaults point at the local Docker Postgres above). To point the
# dashboard at production Supabase instead, override these with the
# session pooler host/port/db/user/password and set GRAFANA_POSTGRES_SSLMODE=require.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_POSTGRES_HOST=postgres
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_DB=fpl
GRAFANA_POSTGRES_USER=fpl
GRAFANA_POSTGRES_PASSWORD=fpl
GRAFANA_POSTGRES_SSLMODE=disable
